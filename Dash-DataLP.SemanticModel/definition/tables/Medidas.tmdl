	measure '% Pedidos Entregues no Prazo MoM %' = DIVIDE([% Pedidos Entregues no Prazo] - [% Pedidos Entregues no Prazo LM], [% Pedidos Entregues no Prazo LM])
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 03. Variações
		lineageTag: 29c9a906-e292-41b6-bf77-d0f365eeac9a

	measure 'Eixo Y Max(Tempo de Resposta)' = ```
			
			
			VAR vTabela = 
			    ALLSELECTED( dCalendario[NomeDoMêsAbrev], dCalendario[Mês], dCalendario[NomeDaSemanaAno], dCalendario[SemanaAno] )
			
			VAR vMaior_valor = 
			    MAXX( vTabela, [Tempo Médio de Resposta (Minutos)] )
			
			VAR vDeslocamento = 1.5
			
			RETURN 
			    vMaior_valor * vDeslocamento 
			```
		displayFolder: 04. Auxiliares
		lineageTag: 0701a100-6fd8-46cb-bbbd-9f0b029d1832

