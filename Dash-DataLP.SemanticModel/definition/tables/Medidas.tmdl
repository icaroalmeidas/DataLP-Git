	measure 'Tempo Médio de Entrega (Minutos)' = ```
			
			AVERAGEX(
			    FILTER(
			        fOrders,
			        NOT(ISBLANK(fOrders[order_moment_finished]))
			    ),
			    DATEDIFF(
			        fOrders[order_moment_created],
			        fOrders[order_moment_finished],
			        MINUTE
			    )
			)
			
			```
		formatString: #,0
		displayFolder: 01. Principais
		lineageTag: 7e0dd080-f901-49c9-82f4-f190c338746d

		annotation PBI_FormatHint = {"isDecimal":true}

	measure '% Pedidos Entregues no Prazo' = ```
			
			VAR TempoEntrega = 90 //Definir o tempo de entrega
			VAR TotalPedidosEntregues = [Pedidos Entregues]
			VAR TotalPedidosNoPrazo =
			    CALCULATE (
			        COUNTROWS ( fOrders ),
			        FILTER (
			            fOrders,
			            NOT ( ISBLANK ( fOrders[order_moment_finished] ) )
			                && DATEDIFF ( fOrders[order_moment_created], fOrders[order_moment_finished], MINUTE ) <= TempoEntrega
			        )
			    )
			RETURN
			    DIVIDE ( TotalPedidosNoPrazo, TotalPedidosEntregues, 0 )
			
			```
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 01. Principais
		lineageTag: 73640dfd-520c-4462-ba60-51e4a34d0759

	measure '% de Pedidos Cancelados' = ```
			
			DIVIDE (
			    CALCULATE ( COUNTROWS ( fOrders ), FILTER ( fOrders, ISBLANK ( fOrders[order_moment_finished] ) ) ),
			    COUNTROWS ( fOrders ),
			    0
			)
			
			```
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 01. Principais
		lineageTag: 1bb7f6ed-2d3c-45ca-8de6-6765891b7c3b

