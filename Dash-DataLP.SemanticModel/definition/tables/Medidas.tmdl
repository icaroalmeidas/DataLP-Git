	measure 'Receita MoM %' = DIVIDE([Receita] - [Receita LM], [Receita LM])
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 03. Variações
		lineageTag: a1f06369-0520-46ea-b169-9857fe383b91

	measure 'IMAGEM CARTÃO RECEITA' = ```
			
			
			VAR vVariacao = [Receita MoM %]
			
			VAR vVariacao_formatado = FORMAT(vVariacao + 0, "+0.0%; -0.0%; 0.0")
			
			VAR vSeta = 
			SWITCH(
			    TRUE(),
			    vVariacao > 0, "⮝",
			    vVariacao < 0, "⮟"
			)
			
			VAR vCor = 
			SWITCH(
			    TRUE(),
			    vVariacao > 0, "59EE74",
			    vVariacao < 0, "red"
			)
			
			VAR vAnimacao = 
			    IF( vVariacao < 0, "animation" ) 
			
			RETURN
			
			"data:image/svg+xml,
			
			<svg  viewBox='0 0 100 40' fill='none' xmlns='http://www.w3.org/2000/svg'>
			
			              <defs>
			            <style>
			
			                #Variacao, #Seta {
			                    " & vAnimacao & ": blink-1 1.5s infinite both;
			                }
			
			                @keyframes blink-1 {
			                    0%,
			                    50%,
			                    100% {
			                        opacity: 1;
			                    }
			                    25%,
			                    75% {
			                        opacity: 0;
			                    }
			                }
			
			            </style> 
			
			        </defs> 
			
				<rect width='100' height='40' fill='#F5F5F5'/>
				<g id='1.Cart&#195;&#163;o.VendasBrutas'>
					<rect width='100' height='40' rx='5' fill='white'/>
					<text id='Seta' fill=' " & vCor & " ' xml:space='preserve' style='white-space: pre' font-family='Segoe UI' font-size='10' font-weight='600' letter-spacing='0em'>
						<tspan x='25' y='13.6406'>   " & vSeta & "   </tspan>
					</text>
					<text id='LY' fill='#071E2F' xml:space='preserve' style='white-space: pre' font-family='Segoe UI' font-size='9' font-weight='600' letter-spacing='0em'>
						<tspan x='7' y='27.7266'>   Mês Anterior   </tspan>
					</text>
					<text id='Variacao' fill=' " & vCor & " ' xml:space='preserve' style='white-space: pre' font-family='Segoe UI' font-size='15' font-weight='600' letter-spacing='0em'>
						<tspan x='40' y='16.2109'>   " & vVariacao_formatado & "   </tspan>
					</text>
				</g>
			</svg>
			
			"
			```
		displayFolder: 04. SVGs
		lineageTag: 49bf65af-fde6-418e-82e2-93f104c49f29

	measure 'Imagem Tabela Cidades' = ```
			
			VAR vCidade = SELECTEDVALUE( dHubs[hub_city] )
			
			VAR vValor = [Receita]
			
			VAR vValor_formatado = 
			    SWITCH(
			        TRUE(),
			        vValor >= 1000000000, FORMAT(vValor, "0,,,.00 Bi"),
			        vValor >= 1000000, FORMAT(vValor, "0,,.00 Mi"),
			        vValor >= 1000, FORMAT(vValor, "0,.00 K"),
			        FORMAT(vValor, "0")
			    ) 
			
			
			VAR vMargem_formatada = FORMAT( [Receita MoM %], "0.00%" ) 
			
			-----------------------------------------
			-- FORMATAÇÕES 
			-----------------------------------------
			
			VAR vFonte = "Segoe UI"
			
			VAR vCidade_cor = "#f1f1f1"
			VAR vCidade_tam = 12 
			
			
			RETURN 
			"
			<svg  width='255' height='79' viewBox='0 0 255 65' fill='none' xmlns='http://www.w3.org/2000/svg'>
			
			    <defs>
			        <style>
			     
			
			            #txt_cidade, #txt_faturamento, #txt_margem {
			                transition: 0.5s
			            }
			
			            svg:hover #txt_cidade {
			                transform:translate(126px)
			            }
			
			            svg:hover #txt_faturamento {
			                transform:translate(-126px)
			            }
			
			            svg:hover #txt_margem {
			                transform:translate(-126px)
			            }
			
			
			        </style> 
			
			    </defs>
			
				<g id='tabela_cidades'>
					<line id='divisor' x1='127.5' y1='14' x2='127.5' y2='50' stroke='white' stroke-opacity='0.1'/>
			
					<text id='txt_cidade' fill='" & vCidade_cor & "'  font-family='" & vFonte & "' font-size='" & vCidade_tam & "' font-weight='400'>
						<tspan x='28' y='37'>
			                " & vCidade & "
			            </tspan>
					</text>
			
					<text id='txt_faturamento' fill='#f1f1f1'  font-family='" & vFonte & "' font-size='13' font-weight='600'>
						<tspan x='155' y='26.2109'>
			                R$ " & vValor_formatado & "
			            </tspan>
					</text>
					<text id='txt_margem' fill='#D1783C'  font-family='" & vFonte & "' font-size='13' font-weight='600'>
						<tspan x='155' y='53.2109'>
			                " & vMargem_formatada & "
			            </tspan>
					</text>
				</g>
			</svg>
			"
			```
		displayFolder: 04. SVGs
		lineageTag: f08d47cc-3b22-44c8-b96f-b4bd1a8b39b4

