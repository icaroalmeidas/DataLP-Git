	measure RetainedCustomers = ```
			
			VAR TotalCustomersInCohort =
			    CALCULATE (
			        DISTINCTCOUNT ( fOrders[store_id] ),
			        FILTER (
			            fOrders,
			            [CohortMonthName] = SELECTEDVALUE ( fOrders[CohortMonthName] )
			        )
			    )
			VAR CustomersInMonth = DISTINCTCOUNT ( fOrders[store_id] )
			RETURN
			    DIVIDE ( CustomersInMonth, TotalCustomersInCohort )
			
			```
		formatString: 0.00%;-0.00%;0.00%
		isHidden
		displayFolder: 01. Principais
		lineageTag: 3db5989e-ce7c-4ccc-990a-16f42bcbc9e1

	measure TempoMédioEntrega = ```
			
			AVERAGEX (
			    SUMMARIZE (
			        dDeliveries,
			        dDeliveries[delivery_order_id],
			        "TempoDeEntrega",
			        VAR AcceptedTime =
			            CALCULATE (
			                MIN ( fOrders[order_moment_accepted] ),
			                FILTER (
			                    fOrders,
			                    fOrders[delivery_order_id] = EARLIER ( dDeliveries[delivery_order_id] )
			                )
			            )
			        VAR FinishedTime =
			            CALCULATE (
			                MAX ( fOrders[order_moment_finished] ),
			                FILTER (
			                    fOrders,
			                    fOrders[delivery_order_id] = EARLIER ( dDeliveries[delivery_order_id] )
			                )
			            )
			        RETURN
			            IF (
			                ISBLANK ( AcceptedTime ) || ISBLANK ( FinishedTime ),
			                BLANK (),
			                DATEDIFF (
			                    AcceptedTime,
			                    FinishedTime,
			                    MINUTE
			                )
			            )
			    ),
			    [TempoDeEntrega]
			)
			
			
			
			```
		formatString: #,0.00
		displayFolder: 01. Principais
		lineageTag: fc9bc305-b92a-4ddf-9d2b-be73c68031a0

	measure DistânciaMédiaEntrega = ```
			
